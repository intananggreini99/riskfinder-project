# ============ RiskFinder · Variabel Lingkungan (root, untuk docker-compose) ============
# Salin menjadi .env lalu sesuaikan.

# --- PostgreSQL ---
POSTGRES_USER=riskfinder
POSTGRES_PASSWORD=riskfinder
POSTGRES_DB=riskfinder

# --- JWT (WAJIB diganti, dipakai bersama kedua service) ---
# Hasilkan: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti-dengan-secret-acak-panjang-di-produksi

# --- Docker Hub (untuk push/pull image) ---
DOCKERHUB_USER=username_dockerhub_anda
