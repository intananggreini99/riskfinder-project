# mlflow-server/.dockerignore
# Aman dipakai untuk kedua image (Dockerfile MLflow & Caddy.Dockerfile),
# karena tidak mengecualikan Caddyfile, entrypoint.sh, atau requirements.txt.
.git
.gitignore
.env
.env.*
__pycache__/
*.pyc
*.pyo
mlruns/
mlartifacts/
.DS_Store
# Berkas dokumentasi & skrip uji tidak perlu masuk image runtime.
*.md
scripts/
