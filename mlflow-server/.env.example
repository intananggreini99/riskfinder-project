# mlflow-server/.env.example
# ===========================================================================
# Contoh environment variables. JANGAN commit nilai rahasia asli.
# Di Railway, isi nilai-nilai ini di tab "Variables" tiap service
# (gunakan reference variable ${{...}}, jangan hard-code rahasia — Bab 5.8).
# ===========================================================================

# ---------------------------------------------------------------------------
# (A) SERVICE MLflow  — variabel pada service MLflow (Bab 5.8)
# ---------------------------------------------------------------------------
# Reference ke service Postgres. WAJIB skema postgresql:// (Gotcha Bab 5.6).
# Di Railway: MLFLOW_BACKEND_STORE_URI=${{Postgres.DATABASE_URL}}
MLFLOW_BACKEND_STORE_URI=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Root tujuan artifact (nama bucket S3-compatible).
MLFLOW_ARTIFACTS_DESTINATION=s3://mlflow-artifacts

# Endpoint S3-compatible lewat jaringan privat.
#  - MinIO di Railway : http://minio.railway.internal:9000
#  - Cloudflare R2    : https://<accountid>.r2.cloudflarestorage.com
MLFLOW_S3_ENDPOINT_URL=http://minio.railway.internal:9000

# Kredensial artifact store. Di Railway pakai reference variable:
#   AWS_ACCESS_KEY_ID=${{MinIO.MINIO_ROOT_USER}}
#   AWS_SECRET_ACCESS_KEY=${{MinIO.MINIO_ROOT_PASSWORD}}
AWS_ACCESS_KEY_ID=minio-access-key
AWS_SECRET_ACCESS_KEY=minio-secret-key

# Wajib untuk sebagian klien S3 (nilai bebas pada MinIO).
AWS_DEFAULT_REGION=us-east-1

# Topologi 2 (di belakang Caddy): set PORT=5000 agar cocok dengan target Caddy.
# Topologi 1 (MLflow punya domain publik): biarkan kosong, Railway mengisinya.
# PORT=5000

# ---------------------------------------------------------------------------
# (B) SERVICE Caddy  — variabel pada service Caddy (Bab 6, opsional tapi disarankan)
# ---------------------------------------------------------------------------
AUTH_USER=mlflow
# Hash dibuat sekali secara lokal, JANGAN simpan password plaintext di sini:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'passwordRahasia'
AUTH_PASSWORD_HASH=$2a$14$contohHashBcryptGantiDenganMilikAnda
# PORT diisi otomatis oleh Railway untuk service Caddy (jangan diset manual).

# ---------------------------------------------------------------------------
# (C) SISI KLIEN — di mesin/CI training ATAU di service ds-service RiskFinder (Bab 7)
# ---------------------------------------------------------------------------
# Domain PUBLIK MLflow (Caddy bila Topologi 2). Tanpa garis miring di akhir.
MLFLOW_TRACKING_URI=https://<domain-anda>.up.railway.app
MLFLOW_TRACKING_USERNAME=mlflow
MLFLOW_TRACKING_PASSWORD=passwordRahasia
